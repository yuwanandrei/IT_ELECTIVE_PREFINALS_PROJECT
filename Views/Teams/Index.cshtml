@model IEnumerable<Team>
@{ ViewData["Title"] = "Teams"; }
<h1>Teams</h1><table><thead><tr><th>Team</th><th>Department</th><th>Team Members</th></tr></thead><tbody>
@foreach (var t in Model) { <tr><td>@t.Name</td><td>@t.Department.Name</td><td>@string.Join(", ", t.Members.Select(m => m.Employee.FullName))</td></tr> }
</tbody></table>
