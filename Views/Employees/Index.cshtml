@model IEnumerable<Employee>
@{ ViewData["Title"] = "Employees"; }
<h1>Employees</h1><table><thead><tr><th>Full Name</th><th>Email</th><th>Job Title</th><th>Department</th><th>Active</th></tr></thead><tbody>
@foreach (var e in Model) { <tr><td>@e.FullName</td><td>@e.Email</td><td>@e.JobTitle</td><td>@e.Department.Name</td><td><span class="badge @(e.IsActive ? "active" : "inactive")">@(e.IsActive ? "Active" : "Inactive")</span></td></tr> }
</tbody></table>
