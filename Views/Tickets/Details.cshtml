@model Ticket
@{ ViewData["Title"] = "Ticket Details"; }
<h1>Ticket #@Model.Id — @Model.Subject</h1>
<div class="detail-grid">
 <div class="card"><h3>Ticket</h3><p><b>Description:</b> @Model.Description</p><p><b>Created:</b> @Model.CreatedAt</p><p><b>Updated:</b> @Model.UpdatedAt</p><p><b>Due:</b> @(Model.DueAt ?? "—")</p></div>
 <div class="card"><h3>Customer</h3><p>@Model.Customer.CompanyName</p><p>@Model.Customer.ContactName</p><p>@Model.Customer.Email</p><p>@(Model.Customer.Phone ?? "—")</p></div>
 <div class="card"><h3>Classification</h3><p><b>Category:</b> @Model.Category.Name</p><p><b>Parent:</b> @(Model.Category.ParentCategory?.Name ?? "Root")</p><p><b>Priority:</b> @Model.Priority.Name</p><p><b>Status:</b> @Model.Status.Name</p></div>
</div>
<div class="card"><h2>Assignments</h2><ul>@foreach (var a in Model.Assignments) { <li>@a.Employee.FullName — @(a.IsPrimary ? "Primary" : "Secondary") — @(a.UnassignedAt == null ? "Active" : "Unassigned")</li> }</ul></div>
<div class="card"><h2>Comments</h2><ul>@foreach (var c in Model.Comments) { <li><b>@(c.Employee?.FullName ?? "Unknown"):</b> @c.Comment <span class="muted">(@c.CreatedAt)</span></li> }</ul></div>
<div class="card"><h2>Tags</h2><p>@string.Join(", ", Model.TicketTags.Select(x => x.Tag.Name))</p></div>
<div class="card"><h2>Attachments</h2><ul>@foreach (var a in Model.Attachments) { <li>@a.FileName — @a.ContentType — @a.FileSize bytes</li> }</ul></div>
</div>
