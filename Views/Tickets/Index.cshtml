@model IEnumerable<Ticket>
@{ ViewData["Title"] = "Tickets"; }
<h1>Tickets</h1><table><thead><tr><th>ID</th><th>Subject</th><th>Customer</th><th>Category</th><th>Priority</th><th>Status</th><th>Created</th><th>Due</th><th></th></tr></thead><tbody>
@foreach (var t in Model) { <tr><td>@t.Id</td><td>@t.Subject</td><td>@t.Customer.CompanyName</td><td>@t.Category.Name</td><td>@t.Priority.Name</td><td>@t.Status.Name</td><td>@t.CreatedAt</td><td>@(t.DueAt ?? "—")</td><td><a class="button" asp-action="Details" asp-route-id="@t.Id">Details</a></td></tr> }
</tbody></table>
